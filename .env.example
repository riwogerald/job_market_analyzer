# Django Settings (CRITICAL: Generate a strong secret key!)
# Use: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY
# Generate API key with: python -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits) for i in range(32)))"
ADMIN_API_KEY=CHANGE_ME_TO_A_SECURE_ADMIN_API_KEY
DEBUG=False
DOMAIN=your-domain.com

# Database Configuration (CRITICAL: Change default password!)
DB_NAME=job_analyzer
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security Configuration
FRONTEND_URL=https://your-frontend-domain.com

# Scraping Configuration
SCRAPING_DELAY=2
MAX_PAGES_PER_SITE=5

# Frontend Configuration
REACT_APP_API_URL=https://your-api-domain.com/api

# Development Only (set DEBUG=True for local development)
# DEBUG=True
# DOMAIN=localhost
# FRONTEND_URL=http://localhost:3000
# REACT_APP_API_URL=http://localhost:8000/api
